//Задание 1
import java.util.Date;
import java.text.SimpleDateFormat;
import java.util.Calendar;

public class Task1 {
    public static void main(String[] args) {
        SimpleDateFormat sdf = new SimpleDateFormat("dd.MM.yyyy HH:mm:ss");
        
        // Дата получения задания (текущая)
        Date dateReceived = new Date();
        
        // Дата сдачи задания (например, завтра)
        Calendar cal = Calendar.getInstance();
        cal.add(Calendar.DAY_OF_MONTH, 1);
        Date dateSubmit = cal.getTime();
        
        System.out.println("Разработчик: Иванов Иван Иванович");
        System.out.println("Дата получения: " + sdf.format(dateReceived));
        System.out.println("Дата сдачи:     " + sdf.format(dateSubmit));
    }
}

//Задание 2
import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.Scanner;

public class Task2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Введите дату (день месяц год через пробел):");
        int day = sc.nextInt();
        int month = sc.nextInt() - 1; 
        int year = sc.nextInt();
        
        Calendar inputCal = Calendar.getInstance();
        inputCal.set(year, month, day);
        Date inputDate = inputCal.getTime();
        
        Date now = new Date();
        
        SimpleDateFormat sdf = new SimpleDateFormat("dd.MM.yyyy");
        System.out.println("Введенная дата: " + sdf.format(inputDate));
        System.out.println("Текущая дата:   " + sdf.format(now));
        
        if (inputDate.before(now)) {
            System.out.println("Введенная дата находится в прошлом.");
        } else if (inputDate.after(now)) {
            System.out.println("Введенная дата находится в будущем.");
        } else {
            System.out.println("Введенная дата совпадает с текущей (с точностью до дня).");
        }
    }
}

//Задание 3
import java.text.SimpleDateFormat;
import java.util.Date;

class Student {
    private String name;
    private Date birthDate;

    public Student(String name, Date birthDate) {
        this.name = name;
        this.birthDate = birthDate;
    }

    // Метод возвращает дату рождения по заданному формату
    public String getFormattedBirthDate(String format) {
        SimpleDateFormat sdf = new SimpleDateFormat(format);
        return sdf.format(birthDate);
    }

    @Override
    public String toString() {
        return "Student{name='" + name + "', birthDate=" + getFormattedBirthDate("dd.MM.yyyy") + "}";
    }
}

public class Task3 {
    public static void main(String[] args) {
        Date birth = new Date(90, 0, 15); 
        Student st = new Student("Алексей", birth);
        
        System.out.println(st);
        System.out.println("Короткий формат: " + st.getFormattedBirthDate("dd.MM.yy"));
        System.out.println("Средний формат:  " + st.getFormattedBirthDate("d MMM yyyy"));
        System.out.println("Полный формат:   " + st.getFormattedBirthDate("EEEE, d MMMM yyyy"));
    }
}

//Задание 4
import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.Scanner;

public class Task4 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        System.out.println("Введите год, месяц, число через пробел:");
        int year = sc.nextInt();
        int month = sc.nextInt() - 1; // 0-11
        int day = sc.nextInt();
        
        System.out.println("Введите часы и минуты через пробел:");
        int hour = sc.nextInt();
        int minute = sc.nextInt();
        
        // Создание Calendar
        Calendar cal = Calendar.getInstance();
        cal.set(year, month, day, hour, minute, 0);
        cal.set(Calendar.MILLISECOND, 0);
        
        // Создание Date из миллисекунд Calendar
        Date date = new Date(cal.getTimeInMillis());
        
        SimpleDateFormat sdf = new SimpleDateFormat("dd.MM.yyyy HH:mm");
        System.out.println("Объект Date:     " + sdf.format(date));
        System.out.println("Объект Calendar: " + sdf.format(cal.getTime()));
    }
}
